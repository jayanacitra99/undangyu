APP_NAME=Undangyu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://undangyu.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=undangyu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage. For Cloudflare R2 set AWS_ENDPOINT to the
# R2 endpoint, AWS_DEFAULT_REGION=auto and AWS_URL to the public bucket URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

HORIZON_PREFIX=undangyu_horizon:

# First super admin, created by AdminUserSeeder. Leave blank and the seeder
# skips rather than creating an account with a known password.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# Payment gateway: driver is undecided (CLAUDE.md "Decisions still open").
# Set PAYMENT_DRIVER once midtrans vs xendit is chosen.
PAYMENT_DRIVER=

# WhatsApp provider: undecided (wablas / fonnte / cloud-api).
WHATSAPP_DRIVER=

VITE_APP_NAME="${APP_NAME}"
